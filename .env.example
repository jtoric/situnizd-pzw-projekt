# Predložak konfiguracije. Kopirati u .env i po potrebi prilagoditi:
#   Linux/macOS:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
# .env ne ulazi u repozitorij.

ENV=dev

# postgresql+asyncpg:// imenuje asinkroni upravljački program
DATABASE_URL=postgresql+asyncpg://pl_user:pl_pass@localhost:5432/pl_reg

# Samo za razvoj. U produkciji: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
