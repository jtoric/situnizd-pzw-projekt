# Predložak tajni za docker-compose.prod.yml. Kopirati u .env.prod i upisati vlastite
# vrijednosti; .env.prod ne ulazi u repozitorij.
#
# Vrijednost stvoriti naredbom:  openssl rand -hex 32
# Heksadekadski zapis ima samo znamenke i slova a-f, pa lozinku baze nije potrebno kodirati
# u adresi DATABASE_URL (znakovi @, / i : u njoj imaju značenje).

DB_PASSWORD=
JWT_SECRET=

# Vrata na računalu na kojima nginx prima zahtjeve
WEB_PORT=8080
