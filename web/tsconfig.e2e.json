// Testovi kroz preglednik (e2e/) i konfiguracija Playwrighta. Izvode se u Nodeu, a dijelovi
// unutar page.evaluate u pregledniku, pa trebaju tipove obaju okruženja.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["e2e/**/*", "playwright.config.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
